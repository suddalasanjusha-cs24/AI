        "rooms = {\n",
        "    \"A\": \"DIRTY\",\n",
        "    \"B\": \"DIRTY\"\n",
        "}\n",
        "\n",
        "current_position = \"A\"\n",
        "\n",
        "def action():\n",
        "    global current_position\n",
        "\n",
        "    if rooms[current_position] == \"DIRTY\":\n",
        "        return \"CLEAN\"\n",
        "\n",
        "    elif current_position == \"A\":\n",
        "        return \"MOVE-RIGHT\"\n",
        "\n",
        "    else:\n",
        "        return \"MOVE-LEFT\"\n",
        "\n",
        "def transition(action_taken):\n",
        "\n",
        "    global current_position\n",
        "\n",
        "    if action_taken == \"CLEAN\":\n",
        "        rooms[current_position] = \"CLEAN\"\n",
        "\n",
        "    elif action_taken == \"MOVE-RIGHT\":\n",
        "        current_position = \"B\"\n",
        "\n",
        "    elif action_taken == \"MOVE-LEFT\":\n",
        "        current_position = \"A\"\n",
        "\n",
        "def goal_test():\n",
        "\n",
        "    if rooms[\"A\"] == \"CLEAN\" and rooms[\"B\"] == \"CLEAN\":\n",
        "        return True\n",
        "    else:\n",
        "        return False\n",
        "\n",
        "print(\"Initial State:\")\n",
        "print(\"Room A:\", rooms[\"A\"])\n",
        "print(\"Room B:\", rooms[\"B\"])\n",
        "print(\"Vacuum Position:\", current_position)\n",
        "\n",
        "print(\"\\nStarting Vacuum Cleaner...\\n\")\n",
        "\n",
        "\n",
        "while not goal_test():\n",
        "\n",
        "    selected_action = action()\n",
        "\n",
        "    print(\"Current Position :\", current_position)\n",
        "    print(\"Action           :\", selected_action)\n",
        "\n",
        "    transition(selected_action)\n",
        "\n",
        "    print(\"Room A           :\", rooms[\"A\"])\n",
        "    print(\"Room B           :\", rooms[\"B\"])\n",
        "    print(\"Vacuum Position  :\", current_position)\n",
        "    print(\"-----------------------------\")\n",
        "\n",
        "print(\"\\nGOAL REACHED!\")\n",
        "print(\"Room A = CLEAN\")\n",
        "print(\"Room B = CLEAN\")\n",
        "print(\"Vacuum Cleaner has stopped.\")"
      ],
